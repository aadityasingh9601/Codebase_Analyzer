# Protects BYOK provider keys at rest (backend/key_vault.py). The per-user
# encryption key is PBKDF2(user_id + MASTER_SECRET). Lose/rotate this and every
# stored key becomes undecryptable; leak it and they are all readable. Keep it
# long, random, and in the secret store — not in git.
MASTER_SECRET=

GITHUB_TOKEN=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_BUCKET=