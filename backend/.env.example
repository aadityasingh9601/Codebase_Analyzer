AI_API_KEY_1=
AI_API_KEY_2=
AI_API_KEY_3=

# Protects BYOK provider keys at rest (backend/key_vault.py). The per-user
# encryption key is PBKDF2(user_id + MASTER_SECRET). Lose/rotate this and every
# stored key becomes undecryptable; leak it and they are all readable. Keep it
# long, random, and in the secret store — not in git.
MASTER_SECRET=

GITHUB_TOKEN=

# Comma-separated browser origins allowed to call the API. The web app calls it
# server-to-server (Next.js server actions), so this only matters when the API
# is exposed to browsers directly — e.g. a deployed frontend at
# https://app.example.com hitting https://api.example.com. Never set it to "*".
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_BUCKET=