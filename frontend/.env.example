# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. `.env.local` is gitignored — never commit
# real values.
#
# Only NEXT_PUBLIC_* vars reach the browser. That is correct for the Supabase
# project URL and the publishable key, which are designed to be public and are
# constrained by Row Level Security.
# ---------------------------------------------------------------------------

# Supabase project settings -> API
# (Project URL and the "Publishable" key, labelled anon/publishable in the UI)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Google OAuth is configured in the Supabase dashboard, NOT here.
#
#   Authentication -> Providers -> Google: paste the client id and client
#   secret Google issued you. That secret must never reach this file — the
#   browser receives every value here, and the whole point of the client
#   secret is that it is not public. Supabase holds it server-side and is the
#   only party that needs it.
#
#   Authentication -> URL Configuration -> Redirect URLs: add the callback
#   below, exactly. Google rejects the request on any mismatch.
#
#   http://localhost:3000/auth/callback      (local)
#   https://<your-domain>/auth/callback      (production)
# ---------------------------------------------------------------------------

# Where the frontend sends repo/chat calls once the backend is wired up.
# Leave blank for now; the UI runs in demo mode until it is set.
NEXT_PUBLIC_BACKEND_URL=
