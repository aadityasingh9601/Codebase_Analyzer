# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. `.env.local` is gitignored — never commit
# real values.
#
# Only NEXT_PUBLIC_* vars reach the browser. That is correct for the Supabase
# project URL and the publishable key, which are designed to be public and are
# constrained by Row Level Security.
# ---------------------------------------------------------------------------

# Supabase project settings -> API
# (Project URL and the "Publishable" key, labelled anon/publishable in the UI)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google sign-in is configured entirely in the Supabase dashboard
# (Authentication -> Providers -> Google). No Google credentials belong here:
# a NEXT_PUBLIC_* value ships to every visitor.
#
# Server-only: base URL of the FastAPI indexing API. Used by Server Actions
# only, so it is deliberately not a NEXT_PUBLIC_ var — a public one could be
# repointed at an attacker-controlled host from someone else's browser.
# Defaults to http://127.0.0.1:8000 when unset.
BACKEND_URL=http://127.0.0.1:8000
