# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. `.env.local` is gitignored — never commit
# real values.
#
# Only NEXT_PUBLIC_* vars reach the browser. That is correct for the Supabase
# project URL and the publishable/anon key, which are designed to be public.
# NEVER put a service-role or secret key in this file: anything here ships to
# the client and would let anyone read or write your whole project.
# ---------------------------------------------------------------------------

# Supabase project settings -> API
# (Project URL and the "Publishable" key, labelled anon/publishable in the UI)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase dashboard -> Authentication -> Providers -> Google.
# Must match the redirect URI below exactly, or Google rejects the request.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_SECRET=

# Supabase dashboard -> Authentication -> URL Configuration.
# Local: http://localhost:3000/auth/callback
# Production: https://<your-domain>/auth/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the frontend sends repo/chat calls once the backend is wired up.
# Leave blank for now; the UI runs in demo mode until it is set.
NEXT_PUBLIC_BACKEND_URL=
